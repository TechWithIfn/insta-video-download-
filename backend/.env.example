# Server
PORT=3001
NODE_ENV=production

# CORS - must match your frontend URL
CORS_ORIGIN=https://yourdomain.com

# Provider configuration
# Options: placeholder, mock, external, puppeteer
RESOLVER_PROVIDER=placeholder
PROVIDER_API_URL=
PROVIDER_API_KEY=

# Dedicated Instagram audio provider (server-side only — never frontend).
# When set, /reels/audio/<id>/ pages resolve through this API, which must
# accept { audioId, url } (Bearer key) and answer
# { success, data: { audioUrl?, media[]?, title?, duration? } }.
# When unset, audio pages fall back to page-based lookup with clear errors.
AUDIO_PROVIDER_URL=
AUDIO_PROVIDER_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Temp store
TEMP_STORE_TTL_MS=600000

# Provider timeout
RESOLVER_TIMEOUT_MS=15000

# Instagram Story downloads (Vercel-compatible)
# Public Stories are attempted without credentials. If Instagram restricts a
# Story (private, expired, or not publicly accessible), the API returns
# "Instagram did not make this Story publicly accessible to the downloader."
# Optional authenticated mode: if you intentionally want to allow private/
# authenticated Story access, set a valid Instagram session cookie here.
# This is NOT required for normal public downloads.
# Supported vars (checked in order): INSTAGRAM_COOKIE, IG_COOKIE, INSTAGRAM_SESSIONID, IG_SESSIONID
# Example full cookie: "sessionid=ABC123...; csrftoken=XYZ...; ds_user_id=123..."
# Example sessionid only: "ABC123..."
# NEVER commit this value or expose it to the frontend.
INSTAGRAM_COOKIE=
# Alternative: INSTAGRAM_SESSIONID=

# Request size limit
MAX_REQUEST_BODY_SIZE=1024
