# Server
PORT=3001
NODE_ENV=production

# CORS - must match your frontend URL
CORS_ORIGIN=https://yourdomain.com

# Provider configuration
# Options: placeholder, mock, external, puppeteer
RESOLVER_PROVIDER=placeholder
PROVIDER_API_URL=
PROVIDER_API_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Temp store
TEMP_STORE_TTL_MS=600000

# Provider timeout
RESOLVER_TIMEOUT_MS=15000

# Request size limit
MAX_REQUEST_BODY_SIZE=1024
