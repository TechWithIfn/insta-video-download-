# Instagram Highlight Downloader - Server-side session (NEVER commit real values, NEVER expose to frontend)
# Copy your logged-in Instagram cookies from browser DevTools > Application > Cookies > instagram.com
# Required for Highlights/Stories that Instagram gates behind login (even public highlights need session)
# This file is loaded server-side only via backend/src/server.ts

# Full cookie string (recommended) - copy as "Cookie:" header value
INSTAGRAM_COOKIE="sessionid=PASTE_HERE; csrftoken=PASTE_HERE; ds_user_id=PASTE_HERE"
# Example real: sessionid=1234567890%3Aabc...; csrftoken=XYZ...; ds_user_id=12345678; mid=...; ig_did=...

# Alternative: individual values (also supported)
# INSTAGRAM_SESSIONID=
# IG_COOKIE=

# Instagram App ID (default 936619743392459 is used if not set)
# X_IG_APP_ID=936619743392459
